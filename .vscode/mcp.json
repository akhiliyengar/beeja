{
  "$schema": "https://aka.ms/vscode-mcp-schema",
  "servers": {
    "beeja": {
      "type": "stdio",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["-m", "beeja.mcp_server"],
      "env": {
        "BEEJA_LLM_BACKEND": "vscode",
        "BEEJA_SHADOW_ROOT": "${workspaceFolder}/shadow"
      }
    }
  }
}
