{
  "$schema": "https://aka.ms/vscode-mcp-schema",
  "servers": {
    "artifact-builder": {
      "type": "stdio",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "skill.mcp_server"],
      "env": {
        "BUILDER_LLM_BACKEND": "vscode",
        "AGENTS_SHADOW_ROOT": "${workspaceFolder}/shadow"
      }
    }
  }
}
