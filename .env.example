# ---- backend selection --------------------------------------------------
# anthropic (default) | vscode
BEEJA_LLM_BACKEND=anthropic

# Backend-specific model. For anthropic: claude-sonnet-4-6, claude-opus-4-7, etc.
# For vscode: any family that vscode.lm exposes (claude-sonnet-4, gpt-4o, ...).
# BEEJA_MODEL=claude-sonnet-4-6

# ---- anthropic backend --------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# ---- vscode bridge backend ----------------------------------------------
# Optional: override the bridge URL. Default is read from ~/.beeja/bridge.port,
# falling back to http://127.0.0.1:21847.
# BEEJA_VSCODE_BRIDGE_URL=http://127.0.0.1:21847

# ---- where draft bundles land -------------------------------------------
# BEEJA_SHADOW_ROOT=~/agents/shadow
