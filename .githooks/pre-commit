#!/usr/bin/env bash
# builder pre-commit hook: keeps _manifest.json in sync, lints, and runs tests.
#
# Install with:
#   git config core.hooksPath .githooks
#
# Skip with:  git commit --no-verify

set -e

# Prefer the project venv if it exists; fall back to whatever 'python' is on PATH.
# This keeps the hook honest on Windows (where bare `python` may resolve to a
# system interpreter that doesn't have ruff/pytest installed).
if   [ -x ".venv/Scripts/python.exe" ]; then PY=".venv/Scripts/python.exe"
elif [ -x ".venv/bin/python"        ]; then PY=".venv/bin/python"
else                                         PY="python"
fi

# Only regenerate if a tracked source file in skill/ is staged.
if git diff --cached --name-only | grep -qE '^skill/.*\.py$'; then
    echo "[builder] regenerating _manifest.json..."
    "$PY" -m skill._manifest --write
    git add skill/_manifest.json
fi

echo "[builder] linting (ruff)..."
"$PY" -m ruff check skill tests

echo "[builder] scanning for dead code..."
"$PY" -m skill._dead_code

echo "[builder] running tests..."
"$PY" -m pytest -q
